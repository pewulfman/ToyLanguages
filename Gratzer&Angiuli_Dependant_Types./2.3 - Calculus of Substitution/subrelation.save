Fixpoint is_ctx_eq (Δ Γ : preContext) : Prop :=
   match Δ, Γ with
   | pctx_one, pctx_one => True
| pctx_ext Δ A, pctx_ext Γ B =>
      is_ctx_eq Δ Γ
      /\ [ Γ ⊢ A == B type ]
      /\ [ Δ ⊢ A == B type ]
   | _, _ => False
   end.

