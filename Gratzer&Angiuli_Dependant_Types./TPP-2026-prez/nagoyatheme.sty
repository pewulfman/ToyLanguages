\ProvidesPackage{nagoyatheme}

\usepackage{xcolor}
\usepackage{graphicx}
\usepackage{helvet}
% \usepackage{zxjatype}
\usepackage[english]{babel}
\renewcommand{\familydefault}{\sfdefault}
% \setCJKsansfont{Noto Sans CJK JP}


% Define Nagoya University green
\definecolor{nagoyaGreen}{HTML}{006E4F}
\definecolor{darkText}{RGB}{34,34,34}


% Theme and color settings
\usetheme{Frankfurt}
\usecolortheme{default}
% flat header: miniframes (no gradient), no subsection row
\useoutertheme[subsection=false]{miniframes}

% Color application
\setbeamercolor{normal text}{fg=darkText, bg=white}
\setbeamercolor{structure}{fg=nagoyaGreen}
\setbeamercolor{frametitle}{fg=white,bg=nagoyaGreen}
\setbeamercolor{block title}{bg=nagoyaGreen, fg=white}
\setbeamercolor{block body}{bg=gray!10, fg=black}
\setbeamercolor{item}{fg=nagoyaGreen}
\setbeamercolor{section in toc}{fg=nagoyaGreen}


% Fonts
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{title}{size=\huge,series=\bfseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\normalsize}
\setbeamerfont{date}{size=\small}
\setbeamerfont{block title}{series=\bfseries}

% Title alignment
\setbeamertemplate{frametitle}[default][center]

% No navigation bar
\setbeamertemplate{navigation symbols}{}

% Optional logo
\pgfdeclareimage[height=1cm]{nagoya-logo}{nagoya-logo.png}
\logo{\pgfuseimage{nagoya-logo}}

\pgfdeclareimage[height=1cm]{nagoya-large}{nagoya-logo-16x9.png}
% Title page layout
\setbeamertemplate{title page}{
   \begin{minipage}[t][\paperheight][c]{\textwidth}
      \centering
      \vfill
      {\usebeamercolor[bg]{title}\usebeamerfont{title}\inserttitle\par}
      \vspace{0.5cm}
      {\usebeamerfont{author}\insertauthor\par}
      \vfill
      {\pgfuseimage{nagoya-large}\par}
      \vspace{0.3cm}
      {\usebeamerfont{institute}\insertinstitute\par}
      \vspace{1cm}
      {\usebeamerfont{date}\insertdate\par}

      \vspace{1cm}
   \end{minipage}
}


% header: dark Nagoya green bar, section names + progress dots
\definecolor{nagoyaDark}{HTML}{0B3B2C}
\definecolor{nagoyaTintDot}{HTML}{9CC9B6}
\setbeamercolor{section in head/foot}{fg=white,bg=nagoyaDark}
\setbeamercolor{mini frame}{fg=white,bg=nagoyaDark}
\setbeamercolor{frametitle}{fg=white,bg=nagoyaGreen}
\setbeamertemplate{frametitle}{%
   \nointerlineskip
   \begin{beamercolorbox}[wd=\paperwidth,ht=2.7ex,dp=1ex,center]{frametitle}%
      \usebeamerfont{frametitle}\insertframetitle
   \end{beamercolorbox}}
% progress dots: filled = shown, ring = current, hollow = to come.
% beamer does not tell the dot template which slide it stands for, so we
% record the first page of each entry and compare it with the current page.
\makeatletter
\let\nagoya@slideentry\slideentry
\def\nagoya@firstpage#1/#2\relax{\def\nagoya@dotpage{#1}}
\def\slideentry#1#2#3#4#5#6{%
   \nagoya@firstpage#4\relax\nagoya@slideentry{#1}{#2}{#3}{#4}{#5}{#6}}
\newcommand\nagoya@dot[1]{% #1 = pgf drawing commands
   \begin{pgfpicture}{0pt}{0pt}{0.1cm}{0.1cm}#1\end{pgfpicture}}
\newcommand\nagoya@pastorfuture{%
   \ifnum\nagoya@dotpage<\c@page
      \nagoya@dot{\pgfsetfillcolor{nagoyaTintDot}%
         \pgfpathcircle{\pgfpoint{0.05cm}{0.05cm}}{0.05cm}\pgfusepath{fill}}%
   \else
      \nagoya@dot{\pgfsetstrokecolor{nagoyaTintDot}\pgfsetlinewidth{0.5pt}%
         \pgfpathcircle{\pgfpoint{0.05cm}{0.05cm}}{0.042cm}\pgfusepath{stroke}}%
   \fi}
\setbeamertemplate{mini frame}{%
   \nagoya@dot{\pgfsetstrokecolor{white}\pgfsetfillcolor{white}\pgfsetlinewidth{0.6pt}%
      \pgfpathcircle{\pgfpoint{0.05cm}{0.05cm}}{0.06cm}\pgfusepath{stroke}%
      \pgfpathcircle{\pgfpoint{0.05cm}{0.05cm}}{0.025cm}\pgfusepath{fill}}}
\setbeamertemplate{mini frame in current subsection}{\nagoya@pastorfuture}
\setbeamertemplate{mini frame in other subsection}{\nagoya@pastorfuture}
\setbeamertemplate{mini frame in other section}{\nagoya@pastorfuture}
\makeatother

% footer: three boxes in Nagoya green, high contrast
%   [ author | short title | short institute    page ]
\definecolor{nagoyaTint}{HTML}{E3F0EB}
\setbeamercolor{foot strong}{fg=white,bg=nagoyaGreen}
\setbeamercolor{foot light}{fg=nagoyaGreen,bg=nagoyaTint}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamertemplate{footline}
{%
   \leavevmode\usebeamerfont{footline}%
   \hbox{%
      \begin{beamercolorbox}[wd=.2\paperwidth,ht=2.4ex,dp=1ex,center]{foot strong}%
         \insertshortauthor
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.52\paperwidth,ht=2.4ex,dp=1ex,center]{foot light}%
         \insertshorttitle
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.28\paperwidth,ht=2.4ex,dp=1ex]{foot strong}%
         \hspace*{2ex}\insertshortinstitute\hfill
         \insertframenumber{} / \inserttotalframenumber\hspace*{2ex}%
      \end{beamercolorbox}}%
}

